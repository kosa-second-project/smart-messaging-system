<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.smartmessaging.mapper.CustomerMapper">

    <!-- 공통 WHERE 조건 (휴면 제외, 광고 차단 제외, 수신 동의, 키워드/태그 필터) -->
    <sql id="commonWhereConditions">
        AND is_deleted = 0
        AND is_ad_blocked = 0
        AND (customer_type IS NULL OR customer_type != '휴면')
        AND id NOT IN (
            SELECT customer_id
            FROM   customer_tag_mapping
            WHERE  tag_id = #{dormantTagId}
              AND  is_deleted = 0
        )
        AND id IN (
            SELECT customer_id
            FROM   customer_tag_mapping
            WHERE  tag_id IN
            <foreach item="tid" collection="consentTagIds" open="(" separator="," close=")">
                #{tid}
            </foreach>
              AND  is_deleted = 0
        )
        <if test="customerIds != null and customerIds.size() > 0">
            AND id IN
            <foreach item="cid" collection="customerIds"
                     open="(" separator="," close=")">
                #{cid}
            </foreach>
        </if>
        <if test="keyword != null and keyword != ''">
            AND (name  LIKE '%' || #{keyword} || '%'
              OR id IN (
                  SELECT ctm.customer_id
                  FROM   customer_tag_mapping ctm
                  JOIN   tag t ON ctm.tag_id = t.id
                  WHERE  t.name LIKE '%' || #{keyword} || '%'
                    AND  ctm.is_deleted = 0
                    AND  t.is_deleted = 0
              ))
        </if>
        <if test="tagIds != null and tagIds.size() > 0">
            <choose>
                <!-- matchType = ALL or AND: 선택한 태그를 모두 가진 고객 (AND) -->
                <when test="matchType == 'ALL' or matchType == 'AND'">
                    AND id IN (
                        SELECT customer_id
                        FROM   customer_tag_mapping
                        WHERE  tag_id IN
                        <foreach item="tagId" collection="tagIds"
                                 open="(" separator="," close=")">
                            #{tagId}
                        </foreach>
                        AND is_deleted = 0
                        GROUP BY customer_id
                        HAVING COUNT(DISTINCT tag_id) = #{tagCount}
                    )
                </when>
                <!-- matchType = ANY (기본): 선택한 태그 중 하나라도 가진 고객 (OR) -->
                <otherwise>
                    AND id IN (
                        SELECT customer_id
                        FROM   customer_tag_mapping
                        WHERE  tag_id IN
                        <foreach item="tagId" collection="tagIds"
                                 open="(" separator="," close=")">
                            #{tagId}
                        </foreach>
                        AND is_deleted = 0
                    )
                </otherwise>
            </choose>
        </if>
    </sql>

    <!-- 1. 고객 목록 조회 (검색어 + 태그 복수 필터 + Oracle 페이징) -->
    <select id="findBySearch" parameterType="CustomerSearchRequest" resultType="CustomerVO">
        SELECT id, phone, name, email,
               customer_type, is_ad_blocked, last_active_at, joined_at
        FROM   customer
        <where>
            <include refid="commonWhereConditions"/>
        </where>
        ORDER BY id ASC
        OFFSET #{offset} ROWS FETCH NEXT #{size} ROWS ONLY
    </select>

    <!-- 2. 총 건수 조회 (페이징 totalPages 계산용) -->
    <select id="countBySearch" parameterType="CustomerSearchRequest" resultType="int">
        SELECT COUNT(*)
        FROM   customer
        <where>
            <include refid="commonWhereConditions"/>
        </where>
    </select>

    <!-- 3. 필터 조건에 맞는 고객 ID 전체 조회 (페이지네이션 없음 - "전체 선택" 기능용) -->
    <select id="findIdsBySearch" parameterType="CustomerSearchRequest" resultType="Long">
        SELECT id
        FROM   customer
        <where>
            <include refid="commonWhereConditions"/>
        </where>
    </select>

    <!-- 4. 고객 ID 목록으로 태그 이름 일괄 조회 (N+1 방지 SELECT IN) -->
    <select id="findTagsByCustomerIds" resultType="map">
        SELECT ctm.customer_id, t.name AS tag_name
        FROM   customer_tag_mapping ctm
        JOIN   tag t ON ctm.tag_id = t.id
        WHERE  ctm.customer_id IN
        <foreach item="id" collection="customerIds"
                 open="(" separator="," close=")">
            #{id}
        </foreach>
        AND ctm.is_deleted = 0
        AND t.is_deleted   = 0
    </select>

</mapper>

